      "name": "Juntar Tutores y Tutorias1"
    },
    {
      "parameters": {
        "jsCode": "const tutorias = $input.all().map(item => item.json);\n\n// Objeto para agrupar las materias\nconst materias = {};\n\nfor (const tutoria of tutorias) {\n\n    // Verificar que exista la materia\n    if (!tutoria.materia) {\n        continue;\n    }\n\n    // Normalizar materia\n    const materia = tutoria.materia\n        .toString()\n        .trim()\n        .toLowerCase()\n        .normalize(\"NFD\")\n        .replace(/[\\u0300-\\u036f]/g, \"\");\n\n    // Crear materia si no existe\n    if (!materias[materia]) {\n        materias[materia] = {\n            nombre: tutoria.materia.toString().trim(),\n            total: 0,\n            pendientes: 0,\n            canceladas: 0\n        };\n    }\n\n    // Contar solicitud\n    materias[materia].total++;\n\n    // Contar estados\n    const estado = (tutoria.estado || \"\").toString().toLowerCase();\n\n    if (estado === \"pendiente\") {\n        materias[materia].pendientes++;\n    }\n\n    if (estado === \"cancelado\") {\n        materias[materia].canceladas++;\n    }\n}\n\n// Convertir a lista y ordenar\nconst reporte = Object.values(materias)\n    .sort((a, b) => b.total - a.total);\n\n// Total de solicitudes válidas\nconst totalSolicitudes = reporte.reduce(\n    (total, materia) => total + materia.total,\n    0\n);\n\n// Crear mensaje\nlet mensaje = `📊 *REPORTE DE DEMANDA DE TUTORÍAS*\\n`;\nmensaje += `━━━━━━━━━━━━━━━━━━\\n\\n`;\n\nif (reporte.length === 0) {\n\n    mensaje += `ℹ️ No se encontraron solicitudes de tutoría.\\n`;\n\n} else {\n\n    mensaje += `📚 *SOLICITUDES POR MATERIA*\\n\\n`;\n\n    reporte.forEach((materia, index) => {\n\n        const porcentaje = totalSolicitudes > 0\n            ? ((materia.total / totalSolicitudes) * 100).toFixed(1)\n            : 0;\n\n        let puesto = \"🔹\";\n\n        if (index === 0) puesto = \"🥇\";\n        else if (index === 1) puesto = \"🥈\";\n        else if (index === 2) puesto = \"🥉\";\n\n        mensaje += `${puesto} *${materia.nombre}*\\n`;\n        mensaje += `   📊 Solicitudes: *${materia.total}*\\n`;\n        mensaje += `   📈 Demanda: *${porcentaje}%*\\n`;\n        mensaje += `   🟢 Pendientes: ${materia.pendientes}\\n`;\n        mensaje += `   🔴 Canceladas: ${materia.canceladas}\\n\\n`;\n    });\n}\n\nmensaje += `━━━━━━━━━━━━━━━━━━\\n`;\nmensaje += `📚 *Materias solicitadas:* ${reporte.length}\\n`;\nmensaje += `📝 *Total de solicitudes:* ${totalSolicitudes}`;\n\nreturn [\n    {\n        json: {\n            mensaje: mensaje , \n            ExisteMensaje: true\n        }\n    }\n];"
      },
